# Nothing in cms/ is reachable from the web except the two endpoints the panel calls and assets/.
# (Templates are included by PHP from disk, which this does not affect.)
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|json|tmp|md|txt)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(clear-cache|pages)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|json|tmp|md|txt)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(clear-cache|pages)\.php$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>
